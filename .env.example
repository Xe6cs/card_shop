# قالب متغيرات البيئة — هذا الملف بلا قيم ويُرفع إلى GitHub كدليل فقط.
# عند الحاجة: انسخه باسم .env.local وضع القيم الحقيقية فيه. ملف .env.local لا يُرفع أبداً.
# على Netlify تُوضع القيم في: Site configuration ← Environment variables
#
# [عام]  = يصل إلى متصفح الزائر، ومسموح أن يكون علنياً.
# [سري]  = للخادم فقط. لا تضعه أبداً في متغير يبدأ بـ NEXT_PUBLIC_ ولا ترسله في المحادثة.

# ===== Supabase — المرحلة 2 =====
# [عام] عنوان مشروع Supabase
NEXT_PUBLIC_SUPABASE_URL=
# [عام] المفتاح العام (anon / publishable) — محمي بقواعد RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [سري] مفتاح الخدمة (service_role / secret) — يتجاوز كل الحمايات
SUPABASE_SERVICE_ROLE_KEY=

# ===== PostHog (الإحصائيات) — المرحلة 1ب =====
# [عام] مفتاح المشروع (يبدأ بـ phc_)
NEXT_PUBLIC_POSTHOG_KEY=
# [عام] خادم الاتحاد الأوروبي
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# [سري] المفتاح الشخصي لقراءة الإحصائيات في لوحة التحكم (يبدأ بـ phx_)
POSTHOG_PERSONAL_API_KEY=

# ===== Resend (البريد: استعادة كلمة المرور والدعوات) — المرحلة 3 =====
# [سري]
RESEND_API_KEY=

# ===== Cloudflare Turnstile (منع الروبوتات في تسجيل الدخول) — المرحلة 3 =====
# [عام]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [سري]
TURNSTILE_SECRET_KEY=
